{
  "info": {
    "_postman_id": "8c22c723-66ec-4e8d-8788-44ef83e6ee11",
    "name": "Open Weather MAP API - Chaining & Dynamic Variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53233168"
  },
  "item": [
    {
      "name": "Get - Geocode city to coordinates",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK - city found\", () => {",
              " pm.response.to.have.status(200);",
              " let res = pm.response.json();",
              " pm.expect(res).to.be.an('array').and.not.empty;",
              "});",
              "",
              "let res = pm.response.json();",
              "if (res.length > 0) {",
              " pm.test(\"Latitude and longitude are valid numbers in range\", () => {",
              " pm.expect(res[0].lat).to.be.a('number').within(-90, 90);",
              " pm.expect(res[0].lon).to.be.a('number').within(-180, 180);",
              " });",
              "",
              " pm.collectionVariables.set(\"lat\", res[0].lat);",
              " pm.collectionVariables.set(\"lon\", res[0].lon);",
              " pm.collectionVariables.set(\"resolved_city\", res[0].name);",
              "} else {",
              " console.warn(\"City not found - keeping previous lat/lon\");",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/geo/1.0/direct?q={{city}}&limit=1&appid={{api_key}}",
          "host": ["{{base_url}}"],
          "path": ["geo", "1.0", "direct"],
          "query": [
            { "key": "q", "value": "{{city}}" },
            { "key": "limit", "value": "1" },
            { "key": "appid", "value": "{{api_key}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get - Current Weather by Coordinates",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 + has required fields\", () => {",
              " pm.response.to.have.status(200);",
              " let res = pm.response.json();",
              " pm.expect(res).to.have.property('main').that.is.an('object');",
              " pm.expect(res).to.have.property('weather').that.is.an('array').not.empty;",
              "});",
              "",
              "let res = pm.response.json();",
              "pm.test(\"Humidity is within valid range 0-100\", () => {",
              " pm.expect(res.main.humidity).to.be.within(0, 100);",
              "});",
              "",
              "pm.test(\"Returned city matches resolved city from geocoding\", () => {",
              " pm.expect(res.name.toLowerCase()).to.eql(pm.collectionVariables.get('resolved_city').toLowerCase());",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/data/2.5/weather?lat={{lat}}&lon={{lon}}&appid={{api_key}}&units=metric",
          "host": ["{{base_url}}"],
          "path": ["data", "2.5", "weather"],
          "query": [
            { "key": "lat", "value": "{{lat}}" },
            { "key": "lon", "value": "{{lon}}" },
            { "key": "appid", "value": "{{api_key}}" },
            { "key": "units", "value": "metric" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get - 5 Day / 3 hours Forecast",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 + list has entries\", () => {",
              " pm.response.to.have.status(200);",
              " let res = pm.response.json();",
              " pm.expect(res.list).to.be.an('array').not.empty;",
              "});",
              "",
              "pm.test(\"Every forecast entry has valid temp and humidity\", () => {",
              " let res = pm.response.json();",
              " res.list.forEach((entry, index) => {",
              " pm.expect(entry.main.temp, `entry ${index} temp`).to.be.a('number');",
              " pm.expect(entry.main.humidity, `entry ${index} humidity`).to.be.within(0, 100);",
              " });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/data/2.5/forecast?lat={{lat}}&lon={{lon}}&units=metric&appid={{api_key}}",
          "host": ["{{base_url}}"],
          "path": ["data", "2.5", "forecast"],
          "query": [
            { "key": "lat", "value": "{{lat}}" },
            { "key": "lon", "value": "{{lon}}" },
            { "key": "units", "value": "metric" },
            { "key": "appid", "value": "{{api_key}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get - 5 Day Air Pollution / AQI Data",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 + list exists\", () => {",
              " pm.response.to.have.status(200);",
              " let res = pm.response.json();",
              " pm.expect(res.list).to.be.an('array').not.empty;",
              "});",
              "",
              "pm.test(\"Every AQI is valid category 1-5\", () => {",
              " let res = pm.response.json();",
              " res.list.forEach((entry, index) => {",
              " pm.expect(entry.main.aqi, `entry ${index} aqi`).to.be.oneOf([1, 2, 3, 4, 5]);",
              " });",
              "});",
              "",
              "pm.test(\"Pollutant components are non-negative numbers\", () => {",
              " let res = pm.response.json();",
              " res.list.forEach((entry) => {",
              " Object.values(entry.components).forEach((val) => {",
              " pm.expect(val).to.be.a('number').at.least(0);",
              " });",
              " });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/data/2.5/air_pollution?lat={{lat}}&lon={{lon}}&appid={{api_key}}",
          "host": ["{{base_url}}"],
          "path": ["data", "2.5", "air_pollution"],
          "query": [
            { "key": "lat", "value": "{{lat}}" },
            { "key": "lon", "value": "{{lon}}" },
            { "key": "appid", "value": "{{api_key}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "NEG - Geocode Invalid City",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid city returns 200 with empty array - OpenWeather behavior\", () => {",
              " pm.response.to.have.status(200);",
              " let res = pm.response.json();",
              " pm.expect(res).to.be.an('array').that.is.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/geo/1.0/direct?q=InvalidCityXYZ123456&limit=1&appid={{api_key}}",
          "host": ["{{base_url}}"],
          "path": ["geo", "1.0", "direct"],
          "query": [
            { "key": "q", "value": "InvalidCityXYZ123456" },
            { "key": "limit", "value": "1" },
            { "key": "appid", "value": "{{api_key}}" }
          ]
        }
      },
      "response": []
    },
    {
      "name": "NEG - Weather with Invalid API Key",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Invalid API key returns 401\", () => {",
              " pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Error message is about invalid API key\", () => {",
              " let res = pm.response.json();",
              " pm.expect(res.message.toLowerCase()).to.include('invalid api key');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/data/2.5/weather?lat={{lat}}&lon={{lon}}&appid=invalid_key_12345&units=metric",
          "host": ["{{base_url}}"],
          "path": ["data", "2.5", "weather"],
          "query": [
            { "key": "lat", "value": "{{lat}}" },
            { "key": "lon", "value": "{{lon}}" },
            { "key": "appid", "value": "invalid_key_12345" },
            { "key": "units", "value": "metric" }
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "base_url", "value": "https://api.openweathermap.org" },
    { "key": "api_key", "value": "YOUR_API_KEY_HERE" },
    { "key": "city", "value": "Ankara" },
    { "key": "lat", "value": "" },
    { "key": "lon", "value": "" },
    { "key": "resolved_city", "value": "" }
  ]
}
