              "    pm.expect(updateData.email).to.eql(pm.collectionVariables.get(\"user_email\"));",
              "    pm.expect(updateData.gender).to.eql(\"female\");",
              "    pm.expect(updateData.status).to.eql(\"inactive\");",
              "});"
