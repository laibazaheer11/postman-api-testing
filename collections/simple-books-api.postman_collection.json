{
  "info": {
    "_postman_id": "0399f36b-c3c5-4df1-a378-1b27c8d345c2",
    "name": "Simple Books API - E2E Ordee Flow",
    "schema": "https://getpostman.com",
    "_exporter_id": "53233168"
  },
  "item": [
    {
      "name": "Get - API Status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "let statusData = pm.response.json();",
              "pm.test(\"API status is OK\", () =>{",
              "  pm.expect(statusData.status).to.eql(\"OK\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/status",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "status"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Register API Client",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var clientName = \"tester\" + Math.floor(Math.random()*100000);",
              "var clientEmail = \"test\" + Date.now() + \"@example.com\";",
              "pm.collectionVariables.set(\"client_name\", clientName);",
              "pm.collectionVariables.set(\"client_email\", clientEmail);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "let clientData = pm.response.json();",
              "",
              "pm.test(\"Response has accessToken\",()=>{",
              "  pm.expect(clientData).to.have.property(\"accessToken\");",
              "  pm.expect(clientData.accessToken).to.be.a(\"string\").and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set(\"access_token\", clientData.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n\"clientName\":\"{{client_name}}\",\n  \"clientEmail\":\"{{client_email}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api-clients",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api-clients"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get - List Available Fiction Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "let booksData = pm.response.json();",
              "pm.test(\"Response is a non-empty array\", function () {",
              "  pm.expect(booksData).to.be.an(\"array\").and.not.empty; ",
              "});",
              "",
              "let availableBook = booksData.find( book => book.available === true);",
              "pm.test(\"At least one available book exists\",()=>{",
              "  pm.expect(availableBook).to.not.be.undefined;",
              "});",
              "",
              "pm.collectionVariables.set(\"book_id\", availableBook.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books?type=fiction&limit=10",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "type",
              "value": "fiction"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Place Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "let orderData = pm.response.json();",
              "",
              "pm.test(\"Response has order Id\",()=>{",
              "  pm.expect(orderData).to.have.property(\"orderId\");",
              "});",
              "",
              "pm.collectionVariables.set(\"order_id\", orderData.orderId);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": {{book_id}},\n  \"customerName\": \"{{client_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Order By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "let getOrderData = pm.response.json();",
              "",
              "pm.test(\"Order Id matches saved order id\", () =>{\",",
              "  pm.expect(getOrderData.id).to.eql(pm.collectionVariables.get(\"order_id\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"updated_name\", \"Updated_\" + pm.collectionVariables.get(\"client_name\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "PATCH",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerName\": \"{{updated_name}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify Order Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "let verifyUpdateData = pm.response.json();",
              "",
              "pm.test(\"Customer name updated correctly\",()=>{",
              "  pm.expect(verifyUpdateData.customerName).to.eql(pm.collectionVariables.get(\"updated_name\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      },
      "response": []
    },
