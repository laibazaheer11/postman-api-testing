      "name": "Delete Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204\", function () {\n  pm.response.to.have.status(204);\n});\n"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify Deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Deleted Order Returns 404\", function () {\n  pm.response.to.have.status(404);\n});\n\npm.collectionVariables.unset(\"order_id\");\npm.collectionVariables.unset(\"book_id\")\npm.collectionVariables.unset(\"access_token\");\npm.collectionVariables.unset(\"client_name\");\npm.collectionVariables.unset(\"client_email\");\npm.collectionVariables.unset(\"updated_name\");\n\n;"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "orders",
            "{{order_id}}"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "https://simple-books-api.click"
    }
  ]
