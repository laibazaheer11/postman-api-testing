    {
      "name": "Verify Deletion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Deleted Order Returns 404\", function () {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.collectionVariables.unset(\"order_id\");",
              "pm.collectionVariables.unset(\"book_id\");",
              "pm.collectionVariables.unset(\"access_token\");",
              "pm.collectionVariables.unset(\"client_name\");",
              "pm.collectionVariables.unset(\"client_email\");",
              "pm.collectionVariables.unset(\"updated_name\");"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/orders/{{order_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
